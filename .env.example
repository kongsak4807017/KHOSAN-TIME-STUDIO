# Studio local server
KHOSAN_HOST=127.0.0.1
KHOSAN_PORT=8080
# Multi-project data roots
# KHOSAN_PROJECTS_DIR=D:\KHOSAN\Projects
# KHOSAN_SHARED_ASSETS_DIR=D:\KHOSAN\SharedAssets
# KHOSAN_MODELS_DIR=D:\KHOSAN\Models
# KHOSAN_TOOL_DATA_DIR=D:\KHOSAN\ToolData
# KHOSAN_CACHE_DIR=D:\KHOSAN\Cache
# KHOSAN_LOGS_DIR=D:\KHOSAN\Logs

# External tool source root
# KHOSAN_EXTERNAL_DIR=C:\KHOSAN\external
# KHOSAN_SKINTOKENS_PYTHON=C:\KHOSAN\external\SkinTokens\.venv\Scripts\python.exe
# KHOSAN_UNIRIG_PYTHON=C:\KHOSAN\external\UniRig\.venv\Scripts\python.exe
# KHOSAN_DEBUG=0

# Optional DevSpace MCP connectivity
KHOSAN_DEVSPACE_PORT=7676
# KHOSAN_DEVSPACE_PUBLIC_URL=https://YOUR-STATIC-TUNNEL-DOMAIN
# KHOSAN_DEVSPACE_DOMAIN=YOUR-STATIC-NGROK-DOMAIN
# KHOSAN_GIT_BASH=C:\Program Files\Git\bin\bash.exe
# KHOSAN_NGROK=C:\path\to\ngrok.exe
# KHOSAN_CLOUDFLARED=C:\path\to\cloudflared.exe
# KHOSAN_CLOUDFLARED_CONFIG=C:\Users\YOU\.cloudflared\config.yml
