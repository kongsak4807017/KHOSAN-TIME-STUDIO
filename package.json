{
  "name": "khosan-time-studio",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "KHOSAN TIME STUDIO local-first Creative Intelligence and Game Studio",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "studio": "node apps/studio-server/server.mjs",
    "verify:source": "node scripts/verify-source.mjs",
    "verify:harness": "python scripts/harness_check.py",
    "doctor:rigging": "python tools/adapters/rigging/doctor.py --json",
    "verify:workspace": "node scripts/smoke-multi-project.mjs",
    "doctor:image-blaster": "node tools/adapters/image-blaster/doctor.mjs",
    "image-blaster": "node tools/adapters/image-blaster/run.mjs",
    "verify:3d-harness": "node --test scripts/test-3d-harness.mjs",
    "harness:3d-verify": "node tools/harness-3d/cli.mjs",
    "verify:part7": "python -m unittest discover -s scripts -p test_part7_hard_locks.py",
    "verify:gateway": "node --test scripts/test-3d-gateway.mjs",
    "harness:gateway": "node tools/harness-3d/gateway-cli.mjs",
    "harness:daemon": "node tools/harness-3d/gateway-daemon.mjs",
    "harness:client": "node tools/harness-3d/gateway-client.mjs",
    "harness:sign": "node tools/harness-3d/gateway-sign.mjs"
  }
}
