{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHOSAN Prototype Experiment",
  "type": "object",
  "required": ["experiment_id","concept_id","hypothesis","target_experience","intentionally_absent","test_context","observation_plan","success_signals","failure_signals","status"],
  "properties": {
    "experiment_id": {"type":"string"},
    "concept_id": {"type":"string"},
    "hypothesis": {"type":"string"},
    "target_experience": {"type":"string"},
    "prototype_scope": {"type":"array","items":{"type":"string"}},
    "intentionally_absent": {"type":"array","items":{"type":"string"}},
    "test_context": {"type":"string"},
    "population": {"type":["string","null"]},
    "observation_plan": {"type":"array","minItems":1,"items":{"type":"string"}},
    "telemetry_plan": {"type":"array","items":{"type":"string"}},
    "success_signals": {"type":"array","minItems":1,"items":{"type":"string"}},
    "failure_signals": {"type":"array","minItems":1,"items":{"type":"string"}},
    "guardrails": {"type":"array","items":{"type":"string"}},
    "confounders": {"type":"array","items":{"type":"string"}},
    "status": {"enum":["planned","active","completed","abandoned"]},
    "result": {"type":["string","null"]},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "next_decision": {"type":["string","null"]}
  },
  "additionalProperties": false
}
