{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHOSAN Creative Evolution Record",
  "type": "object",
  "required": ["evolution_id","project_id","new_concept_id","parent_concepts","evidence_refs","carried_forward","discarded","rationale","human_decision"],
  "properties": {
    "evolution_id": {"type":"string"},
    "project_id": {"type":"string"},
    "new_concept_id": {"type":"string"},
    "parent_concepts": {"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "carried_forward": {
      "type":"array",
      "items":{
        "type":"object",
        "required":["source_concept","element","reason"],
        "properties":{
          "source_concept":{"type":"string"},
          "element":{"type":"string"},
          "reason":{"type":"string"}
        },
        "additionalProperties": false
      }
    },
    "discarded": {"type":"array","items":{"type":"string"}},
    "new_hypotheses": {"type":"array","items":{"type":"string"}},
    "rationale": {"type":"string"},
    "human_decision": {"enum":["continue","prototype","hold","kill","promote_to_constitution"]},
    "decision_reference": {"type":["string","null"]}
  },
  "additionalProperties": false
}
