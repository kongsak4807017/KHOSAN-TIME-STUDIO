{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KHOSAN Work Item",
  "type": "object",
  "required": ["task_id","title","status","owner_role","objective","allowed_paths","forbidden_paths","acceptance_criteria","verification"],
  "properties": {
    "task_id": {"type":"string","pattern":"^TASK-[A-Z0-9-]+$"},
    "feature_id": {"type":["string","null"]},
    "title": {"type":"string","minLength":1},
    "status": {"enum":["proposed","specified","approved","active","verify","rework","blocked","accepted","released"]},
    "owner_role": {"type":"string"},
    "contributors": {"type":"array","items":{"type":"string"}},
    "objective": {"type":"string","minLength":1},
    "context_files": {"type":"array","items":{"type":"string"}},
    "allowed_paths": {"type":"array","items":{"type":"string"}},
    "forbidden_paths": {"type":"array","items":{"type":"string"}},
    "acceptance_criteria": {"type":"array","minItems":1,"items":{"type":"string"}},
    "verification": {"type":"array","minItems":1,"items":{"type":"string"}},
    "human_gates": {"type":"array","items":{"type":"string"}},
    "dependencies": {"type":"array","items":{"type":"string"}},
    "risks": {"type":"array","items":{"type":"string"}},
    "notes": {"type":"string"}
  },
  "additionalProperties": false
}
